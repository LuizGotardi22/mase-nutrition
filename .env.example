# Copie este arquivo para .env e preencha
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção: https://seudominio.com.br (o webhook do Pix só funciona com HTTPS público)
SITE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# Mercado Pago: Access Token e Public Key (comece pelos de teste, que começam com TEST-; troque pelos de
# produção só no final). Pegue os dois em mercadopago.com.br > seu negócio > credenciais.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

WHATSAPP_NUMBER=5511999999999

# True = quem entra no site precisa fazer login ou criar conta. Padrão False = site público (login só é pedido na compra).
LOGIN_OBRIGATORIO=False

# Onde ficam as contas dos clientes (JSON). Padrão: data/contas.json
# CONTAS_JSON_PATH=data/contas.json

# True = a compra exige o cupom do profissional de saúde que indicou (briefing). False (padrão) = compra livre.
PRESCRITOR_OBRIGATORIO=False

# Programa Mase Contínua: benefício (%) nas compras recorrentes (valor de exemplo)
CONTINUA_BENEFICIO_PERCENTUAL=5

# E-mail: avisos de novos leads/cadastros. Sem EMAIL_HOST os e-mails aparecem no terminal.
EMAIL_COMERCIAL=
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=site@masenutrition.com.br

# Redes sociais (deixe vazio o que não existir)
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=
SOCIAL_THREADS=
SOCIAL_X=
PIX_EXPIRA_MINUTOS=60

# Frete: o valor vem da tabela "Frete por estado" do painel (/painel/). FRETE_FIXO só é usado se o estado não estiver na tabela.
# FRETE_GRATIS_ACIMA=0 desativa frete grátis (ex: 300 = grátis a partir de R$ 300).
FRETE_FIXO=19.90

# Cotação real das transportadoras (Melhor Envio) - opcional. Precisa do CEP de origem (de onde você despacha).
CEP_ORIGEM=
MELHOR_ENVIO_TOKEN=
# True se o token for do ambiente de testes (sandbox) do Melhor Envio
MELHOR_ENVIO_SANDBOX=False
FRETE_GRATIS_ACIMA=0

# PostgreSQL (opcional; sem isso usa SQLite)
# DB_NAME=mase
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Vercel / produção ---
# A Vercel define DATABASE_URL sozinha ao conectar um Postgres. Local, deixe vazio para usar o SQLite.
# DATABASE_URL=
# Domínio próprio (a Vercel já libera *.vercel.app). Ex: https://www.masenutrition.com.br
# SITE_URL=
# ALLOWED_HOSTS=www.masenutrition.com.br
# CSRF_TRUSTED_ORIGINS=https://www.masenutrition.com.br
